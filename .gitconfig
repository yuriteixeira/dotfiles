[core]
  excludesfile = ~/.gitignore_global
  autocrlf = input

[init]
  defaultBranch = master

[push]
  default = current

[pull]
  default = current
  rebase = true

[rebase]
  autosquash = true

[diff]
  tool = nvim-diff

[interactive]
  diffFilter = delta --color-only

[pager]
  diff = delta --paging=never
  log = delta
  reflog = delta
  show = delta
  branch = false

[mergetool]
	keepBackup = false
	trustExitCode = true

[mergetool "nvim-bundled-diff"]
  cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[mergetool "nvim-plugin-diffconflicts"]
	cmd = nvim -c DiffConflictsWithHistory \"$MERGED\" \"$BASE\" \"$LOCAL\" \"$REMOTE\"

[merge]
	tool = nvim-plugin-diffconflicts

[color "diff"]
  meta = yellow bold

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

### 3rd Party Tools

[delta]
  plus-style = "syntax #012800"
  minus-style = "syntax #340001"
  syntax-theme = base16-256
  navigate = true

[alias]

  ### FLOW

  # clean
  cl = checkout -- . && git reset --hard && git clean -idfx

  # get
  u = pull --rebase
  f = fetch
  fa = fetch --all
  fo = fetch origin

  # change
  b = branch --sort=-committerdate 

  co = checkout
  com = checkout master

  a = add

  st = stash

  c = commit -v # with diff
  ca = commit -v --amend --no-edit
  can = commit -v --amend --no-edit -n
  cae = commit -v --amend

  ch = cherry-pick

  re = reset
  rep = reset HEAD~
  reom = reset origin/master
  rehom = reset --hard origin/master

  mt = mergetool

  # check
  s = status --ignore-submodules

  h = log --follow -p -M --stat # history of a file
  l = log --pretty='%C(red)%h %C(reset)%s %C(bold blue)%an, %C(green)%cr%C(yellow)%d %C(reset)' # usually my favorite format
  lo = log # default format (comes with more info)
  rl = reflog

  d = diff
  dc = diff --cached

  # organise
  r = rebase
  rom = rebase origin/master
  ri = rebase -i
  riom = rebase -i origin/master

  # send
  p = push -u
  pf = push --force-with-lease # checks for same parent commit on origin before
