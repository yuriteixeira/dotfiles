### Common

alias ll="ls -l"
alias la="ls -lah"

alias dot="cd $DOTFILES"
alias rg="rg --hidden --glob '!.git' --glob '!node_modules'"
alias fd="fd --hidden --no-ignore --exclude node_modules --exclude .git"
alias ff="ff --logo none"
alias glow='glow -s "$HOME/.config/glow/base16.json"'

if [[ "$(uname)" == "Darwin" ]] then
  alias sed="gsed"
fi

# Hosts
alias hosts="sudo $EDITOR /etc/hosts"


# New file: Touch + Creates dir path (if needed)
function n {
  [ -z "$1" ] && echo "ERROR: Path, pls..." && return 1
  local filepath=$1
  local dirpath=$(dirname $filepath)
  [ ! -d "$dirpath" ] && mkdir -p $dirpath
  touch $filepath
  $EDITOR $filepath
}

