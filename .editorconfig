# EditorConfig helps maintain consistent coding styles.
# More info: https://editorconfig.org/

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts
[*.sh]
indent_size = 2

# Config files
[*.conf]
indent_size = 2
indent_style = space

# TOML files
[*.toml]
indent_size = 2

# JSON files (keep standard JSON formatting)
[*.json]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Git-related files
[.gitignore,.gitmodules,.gitattributes]
indent_size = 0
indent_style = tab

# Desktop files
[*.desktop]
indent_size = 0
indent_style = tab

# Plist files
[*.plist]
indent_size = 4
