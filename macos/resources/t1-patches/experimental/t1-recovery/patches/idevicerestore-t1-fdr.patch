+static int t1_read_plist_file(const char* path, plist_t* out)
+{
+	FILE* fp = fopen(path, "rb");
+	if (!fp) return -1;
+	if (fseek(fp, 0, SEEK_END) != 0) { fclose(fp); return -1; }
+	long length = ftell(fp);
+	if (length <= 0 || fseek(fp, 0, SEEK_SET) != 0) { fclose(fp); return -1; }
+	char* data = malloc((size_t)length);
+	if (!data || fread(data, 1, (size_t)length, fp) != (size_t)length) {
+		free(data); fclose(fp); return -1;
+	}
+	fclose(fp);
+	plist_from_memory(data, (uint32_t)length, out, NULL);
+	free(data);
+	return *out ? 0 : -1;
+}
+
+static int t1_write_plist_atomic(const char* path, plist_t value)
+{
+	char* data = NULL;
+	uint32_t length = 0;
+	plist_to_bin(value, &data, &length);
+	if (!data || !length) return -1;
+	size_t tmp_len = strlen(path) + 5;
+	char* tmp = malloc(tmp_len);
+	if (!tmp) { plist_mem_free(data); return -1; }
+	snprintf(tmp, tmp_len, "%s.tmp", path);
+	int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (fd < 0) { free(tmp); plist_mem_free(data); return -1; }
+	size_t done = 0;
+	while (done < length) {
+		ssize_t n = write(fd, data + done, length - done);
+		if (n <= 0) { close(fd); unlink(tmp); free(tmp); plist_mem_free(data); return -1; }
+		done += (size_t)n;
+	}
+	int ok = (fsync(fd) == 0 && close(fd) == 0 && chmod(tmp, 0600) == 0 && rename(tmp, path) == 0);
+	if (!ok) unlink(tmp);
+	free(tmp);
+	plist_mem_free(data);
+	return ok ? 0 : -1;
+}
