+static int restore_handle_t1_fdr_memory_commit(struct idevicerestore_client_t* client, plist_t message)
+{
+	const char* output = getenv("IDEVICERESTORE_T1_FDR_OUTPUT");
+	if (!output || !*output) {
+		logger(LL_ERROR, "T1 FDR output path is not configured\n");
+		return -1;
+	}
+	plist_t args = plist_dict_get_item(message, "Arguments");
+	if (!PLIST_IS_DICT(args)) {
+		logger(LL_ERROR, "FDRMemoryCommit has no Arguments dictionary\n");
+		return -1;
+	}
+	plist_t store = plist_dict_get_item(args, "FDRMemoryStoreData");
+	if (!store) store = args;
+	if (!PLIST_IS_DICT(store) || t1_write_plist_atomic(output, store) < 0) {
+		logger(LL_ERROR, "Unable to save T1 FDR memory store\n");
+		return -1;
+	}
+
+	restore_service_client_t service = _restore_get_service_client_for_data_request(client, message);
+	if (!service) return -1;
+	plist_t reply = plist_new_dict();
+	plist_dict_set_item(reply, "FDRMemoryCommit", plist_new_bool(1));
+	restored_error_t err = _restore_service_send(service, reply, 0);
+	plist_free(reply);
+	_restore_service_free(service);
+	if (err != RESTORE_E_SUCCESS) return -1;
+	logger(LL_INFO, "Saved and acknowledged T1 FDR memory store\n");
+	return 0;
+}
