+static int t1_capture_preflight_pair(struct idevicerestore_client_t* client, plist_t build_identity)
+{
+	const char* image_path = getenv("IDEVICERESTORE_T1_PREFLIGHT_MEMBOOT_SAVE");
+	const char* ticket_path = getenv("IDEVICERESTORE_T1_PREFLIGHT_TICKET_SAVE");
+	if ((!image_path || !*image_path) && (!ticket_path || !*ticket_path)) return 0;
+	if (!image_path || !*image_path || !ticket_path || !*ticket_path) {
+		logger(LL_ERROR, "Both T1 preflight output paths must be configured\n");
+		return -1;
+	}
+
+	unsigned char* ticket = NULL;
+	unsigned int ticket_size = 0;
+	if (tss_response_get_ap_img4_ticket(client->tss, &ticket, &ticket_size) < 0 || !ticket_size) {
+		free(ticket);
+		logger(LL_ERROR, "Unable to extract T1 preflight AP ticket\n");
+		return -1;
+	}
+	if (t1_write_file_atomic(ticket_path, ticket, ticket_size) < 0) {
+		free(ticket);
+		logger(LL_ERROR, "Unable to save T1 preflight AP ticket\n");
+		return -1;
+	}
+	free(ticket);
+
+	size_t tmp_len = strlen(image_path) + 5;
+	char* tmp = malloc(tmp_len);
+	if (!tmp) return -1;
+	snprintf(tmp, tmp_len, "%s.tmp", image_path);
+	int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0600);
+	if (fd < 0) { free(tmp); return -1; }
+
+	const char* components[] = { "OSRamdisk", "KernelCache", "DeviceTree", "SEP", NULL };
+	for (int i = 0; components[i]; i++) {
+		char* component_path = NULL;
+		void* source = NULL;
+		size_t source_size = 0;
+		void* personalized = NULL;
+		size_t personalized_size = 0;
+		if (build_identity_get_component_path(build_identity, components[i], &component_path) < 0 ||
+		    extract_component(client->ipsw, component_path, &source, &source_size) < 0 ||
+		    personalize_component(client, components[i], source, source_size, client->tss,
+		                          &personalized, &personalized_size) < 0) {
+			free(component_path); free(source); free(personalized);
+			close(fd); unlink(tmp); free(tmp);
+			logger(LL_ERROR, "Unable to personalize T1 preflight component %s\n", components[i]);
+			return -1;
+		}
+		free(component_path);
+		free(source);
+		size_t done = 0;
+		while (done < personalized_size) {
+			ssize_t n = write(fd, (char*)personalized + done, personalized_size - done);
+			if (n <= 0) {
+				free(personalized); close(fd); unlink(tmp); free(tmp); return -1;
+			}
+			done += (size_t)n;
+		}
+		logger(LL_INFO, "Captured personalized T1 component %s (%zu bytes)\n", components[i], personalized_size);
+		free(personalized);
+	}
+	int ok = (fsync(fd) == 0 && close(fd) == 0 && chmod(tmp, 0600) == 0 && rename(tmp, image_path) == 0);
+	if (!ok) unlink(tmp);
+	free(tmp);
+	if (!ok) return -1;
+	logger(LL_INFO, "Saved matching T1 preflight image and AP ticket\n");
+	return 0;
+}
